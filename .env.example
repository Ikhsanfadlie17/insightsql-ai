# Copy to .env and fill in. Never commit .env.

# --- LLM (required for AI Analyst; everything else works without it) ---
OPENAI_API_KEY=
# Any model ID your OpenAI account can access. Nothing is hard-coded in the app.
OPENAI_MODEL=
# Optional: cheaper model for insight summaries (defaults to OPENAI_MODEL)
OPENAI_INSIGHT_MODEL=
# Per-request timeout, bounded retries (timeouts, rate limits, 5xx only), output cap
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1500

# --- Storage & limits ---
DATA_DIR=data
MAX_UPLOAD_MB=50
QUERY_TIMEOUT_SECONDS=10
MAX_RESULT_ROWS=5000
# DuckDB limits per query
QUERY_THREADS=2
QUERY_MEMORY_LIMIT=512MB
# Hard limits for the isolated query worker process (killed when exceeded)
QUERY_PROCESS_MEMORY_MB=1024
QUERY_ADDRESS_SPACE_MB=4096
MAX_RESULT_BYTES=20000000
# Automatic SQL repair attempts after a failure (0-2)
MAX_SQL_REPAIRS=2

# --- Privacy & cost ---
# Send short sample values (never for client ID/name columns) to the LLM
SEND_SAMPLE_VALUES=true
# Use the LLM for narrative insights (false = deterministic summaries only)
ENABLE_LLM_INSIGHTS=true
# Model prices for cost estimates (USD per 1M tokens); unknown models show "N/A"
PRICING_FILE=config/pricing.json

LOG_LEVEL=INFO

# --- Frontend ---
BACKEND_URL=http://localhost:8000
